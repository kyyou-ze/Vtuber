<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- GLSurfaceView avatar ditambahkan ke sini secara programatik -->
    <FrameLayout
        android:id="@+id/glContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        app:fabSize="mini"
        android:contentDescription="Pengaturan API key"
        android:src="@android:drawable/ic_menu_manage"
        app:backgroundTint="#2A2A3A"
        app:tint="#FFFFFF" />

    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="88dp"
        android:minHeight="56dp"
        android:padding="12dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:background="#992A2A3A"
        android:text="" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnMic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:contentDescription="Tekan untuk bicara"
        android:src="@android:drawable/ic_btn_speak_now"
        app:backgroundTint="#FFB6D9" />

</FrameLayout>
